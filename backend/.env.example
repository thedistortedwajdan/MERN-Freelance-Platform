MONGO_URI=mongodb://localhost:27017/gigpilot
# Must be at least 32 characters
JWT_SECRET=change-me-to-a-long-random-secret-value
PORT=5000
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Optional: creates an admin account on startup if it does not exist
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Dev only: print password-reset / verification tokens to the server log
LOG_AUTH_TOKENS=true
